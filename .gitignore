ios/fastlane/report.xml
ios/fastlane/README.md
ios/fastlane/test_output/

# Build artifacts
*.ipa
*.dSYM.zip

# FVM Version Cache
.fvm/
# Android build output
android/build/

# Doppler-materialised secrets (template dart_defines.example.json IS committed)
dart_defines.json

# mentalmetal-fastlane artifacts (generated by deploy lanes)
fastlane/report.xml
fastlane/README.md
fastlane/Preview.html
fastlane/test_output/
# review contact details (name/email/phone) — PUBLIC repo, never commit
fastlane/metadata/review_information/

