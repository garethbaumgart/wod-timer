app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated Dart is committed: `dart run build_runner` hangs on Flutter
# 3.47.7 (analyzer 7.6.0 missing visitDotShorthandPropertyAccess), so a
# clean checkout must analyze/test without codegen. See docs/data-safety.md.

# Environment files
.env
.env.*

# Coverage
coverage/

# Test results
test-results/

